+/* Off by default, because the Steam client owns the IMU setting while Steam Input has the Deck.
+ * When set, the driver keeps the IMU sampling while sensors are enabled, see SetSensorsEnabled. */
+#ifndef SDL_HINT_JOYSTICK_HIDAPI_STEAMDECK_IMU
+#define SDL_HINT_JOYSTICK_HIDAPI_STEAMDECK_IMU "SDL_JOYSTICK_HIDAPI_STEAMDECK_IMU"
+#endif
+
 enum
 {
     SDL_GAMEPAD_BUTTON_STEAM_DECK_QAM = 11,
@@ -85,6 +91,9 @@ typedef struct
     Uint64 sensor_timestamp_ns;
     Uint64 last_button_state;
     Uint8 watchdog_counter;
+    bool keep_imu_on;
+    bool imu_silent;
+    Uint64 last_imu_enable;
 
     bool left_touch_down;
     float left_touch_x;
@@ -158,6 +167,28 @@ static bool FeedDeckLizardWatchdog(SDL_hid_device *dev)
     return true;
 }
 
+static bool EnableDeckIMU(SDL_hid_device *dev)
+{
+    int rc;
+    Uint8 buffer[HID_FEATURE_REPORT_BYTES + 1] = { 0 };
+    FeatureReportMsg *msg = (FeatureReportMsg *)(buffer + 1);
+
+    msg->header.type = ID_SET_SETTINGS_VALUES;
+    msg->header.length = 1 * sizeof(ControllerSetting);
+    msg->payload.setSettingsValues.settings[0].settingNum = SETTING_IMU_MODE;
+    msg->payload.setSettingsValues.settings[0].settingValue = (SETTING_GYRO_MODE_SEND_RAW_ACCEL | SETTING_GYRO_MODE_SEND_RAW_GYRO);
+
+    rc = SDL_hid_send_feature_report(dev, buffer, sizeof(buffer));
+    if (rc != sizeof(buffer))
+        return false;
+
+    // There may be a lingering report read back after changing settings.
+    // Discard it.
+    SDL_hid_get_feature_report(dev, buffer, sizeof(buffer));
+
+    return true;
+}
