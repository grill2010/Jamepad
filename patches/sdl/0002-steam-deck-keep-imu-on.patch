     SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_ACCEL, ctx->sensor_timestamp_ns, values, 3);
 
+    // Gravity alone keeps a sampling accelerometer off zero, so all zeros means the IMU is off.
+    ctx->imu_silent = (pInReport->payload.deckState.sAccelX == 0 &&
+                       pInReport->payload.deckState.sAccelY == 0 &&
+                       pInReport->payload.deckState.sAccelZ == 0 &&
+                       pInReport->payload.deckState.sGyroX == 0 &&
+                       pInReport->payload.deckState.sGyroY == 0 &&
+                       pInReport->payload.deckState.sGyroZ == 0);
+
     bool left_touch_down = (pInReport->payload.deckState.ulButtonsL & STEAMDECK_LBUTTON_LEFT_TOUCHPAD_TOUCH) ? true : false;
     bool right_touch_down = (pInReport->payload.deckState.ulButtonsL & STEAMDECK_LBUTTON_RIGHT_TOUCHPAD_TOUCH) ? true : false;
     if (left_touch_down || ctx->left_touch_down) {
@@ -401,6 +440,16 @@ static bool HIDAPI_DriverSteamDeck_UpdateDevice(SDL_HIDAPI_Device *device)
         }
     } while (r > 0);
 
+    if (ctx->keep_imu_on && ctx->imu_silent) {
+        // The Steam client switches the IMU off again, when its overlay closes for instance.
+        // Switch it back on, but no more than once a second while that does not take.
+        Uint64 now = SDL_GetTicks();
+        if (now - ctx->last_imu_enable >= 1000) {
+            EnableDeckIMU(device->dev);
+            ctx->last_imu_enable = now;
+        }
+    }
+
     return true;
 }
 
@@ -467,13 +516,27 @@ static bool HIDAPI_DriverSteamDeck_SendJoystickEffect(SDL_HIDAPI_Device *device,
 
 static bool HIDAPI_DriverSteamDeck_SetSensorsEnabled(SDL_HIDAPI_Device *device, SDL_Joystick *joystick, bool enabled)
 {
-    // On steam deck, sensors are enabled by default. Nothing to do here.
+    SDL_DriverSteamDeck_Context *ctx = (SDL_DriverSteamDeck_Context *)device->context;
+
+    // On steam deck, sensors are enabled by default, but the Steam client switches the IMU off
+    // while Steam Input has no gyro bound for the focused application. Only take the setting over
+    // when asked to, and never switch the IMU off, which is how the Deck behaves without Steam.
+    ctx->keep_imu_on = enabled && SDL_GetHintBoolean(SDL_HINT_JOYSTICK_HIDAPI_STEAMDECK_IMU, false);
+    if (ctx->keep_imu_on) {
+        // A failed write is retried from UpdateDevice once the reports show the IMU still off.
+        EnableDeckIMU(device->dev);
+        ctx->last_imu_enable = SDL_GetTicks();
+    }
     return true;
 }
 
 static void HIDAPI_DriverSteamDeck_CloseJoystick(SDL_HIDAPI_Device *device, SDL_Joystick *joystick)
 {
-    // Lizard mode id automatically re-enabled by watchdog. Nothing to do here.
+    SDL_DriverSteamDeck_Context *ctx = (SDL_DriverSteamDeck_Context *)device->context;
+
+    // Lizard mode id automatically re-enabled by watchdog. The IMU is left on.
+    ctx->keep_imu_on = false;
+    ctx->imu_silent = false;
 }
 
